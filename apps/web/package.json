{
  "name": "@bloodyfights/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tabellone giocabile della fase 1, senza dipendenze",
  "scripts": {
    "build": "node --experimental-strip-types --disable-warning=ExperimentalWarning strumenti/compila.mjs",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning strumenti/servi.mjs",
    "preview": "node --experimental-strip-types --disable-warning=ExperimentalWarning strumenti/servi.mjs --senza-watch",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/*.test.ts"
  },
  "dependencies": {
    "@bloodyfights/bot": "*",
    "@bloodyfights/motore": "*",
    "@bloodyfights/pixel": "*"
  },
  "devDependencies": {
    "@bloodyfights/server": "*"
  }
}