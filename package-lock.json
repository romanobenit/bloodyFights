{
  "name": "bloodyfights",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "bloodyfights",
      "version": "0.1.0",
      "license": "UNLICENSED",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": "22.x"
      }
    },
    "apps/web": {
      "name": "@bloodyfights/web",
      "version": "0.1.0",
      "dependencies": {
        "@bloodyfights/bot": "*",
        "@bloodyfights/motore": "*",
        "@bloodyfights/pixel": "*"
      }
    },
    "node_modules/@bloodyfights/bot": {
      "resolved": "packages/bot",
      "link": true
    },
    "node_modules/@bloodyfights/motore": {
      "resolved": "packages/motore",
      "link": true
    },
    "node_modules/@bloodyfights/pixel": {
      "resolved": "packages/pixel",
      "link": true
    },
    "node_modules/@bloodyfights/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@bloodyfights/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/bot": {
      "name": "@bloodyfights/bot",
      "version": "0.1.0",
      "dependencies": {
        "@bloodyfights/motore": "*"
      }
    },
    "packages/motore": {
      "name": "@bloodyfights/motore",
      "version": "0.1.0",
      "devDependencies": {
        "@bloodyfights/bot": "*"
      }
    },
    "packages/pixel": {
      "name": "@bloodyfights/pixel",
      "version": "0.1.0",
      "dependencies": {
        "@bloodyfights/motore": "*"
      }
    },
    "packages/server": {
      "name": "@bloodyfights/server",
      "version": "0.1.0",
      "dependencies": {
        "@bloodyfights/motore": "*"
      }
    }
  }
}
